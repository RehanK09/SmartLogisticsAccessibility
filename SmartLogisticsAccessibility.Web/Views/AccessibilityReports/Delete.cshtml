@model SmartLogisticsAccessibility.Web.Models.AccessibilityReport
@{ ViewData["Title"] = "Delete Report"; }
<div class="page-header"><h1 class="text-danger"><i class="bi bi-trash me-2"></i>Delete Accessibility Report</h1></div>
<div class="card" style="max-width:520px">
    <div class="card-body">
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>This action cannot be undone.</div>
        <dl class="row mb-3">
            <dt class="col-sm-4">Location</dt><dd class="col-sm-8 fw-bold">@(Model.Location?.Name ?? "—")</dd>
            <dt class="col-sm-4">Title</dt><dd class="col-sm-8">@Model.Title</dd>
            <dt class="col-sm-4">Score</dt><dd class="col-sm-8">@Model.AccessibilityScore%</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Confirm Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
