@model IEnumerable<SmartLogisticsAccessibility.Web.Models.AccessibilityReport>
@using SmartLogisticsAccessibility.Web.Models
@{
    ViewData["Title"] = "Accessibility Reports";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-clipboard2-check me-2 text-success"></i>Accessibility Reports</h1>
        <div class="page-subtitle">User-submitted accessibility information for logistics locations</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Report</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label mb-1">Search</label><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Location name, reporter…" /></div>
            <div class="col-md-4">
                <label class="form-label mb-1">Rating Filter</label>
                <select name="rating" class="form-select">
                    <option value="">All Ratings</option>
                    <option value="FullyAccessible" selected="@(ViewBag.Rating == "FullyAccessible")">Fully Accessible</option>
                    <option value="PartiallyAccessible" selected="@(ViewBag.Rating == "PartiallyAccessible")">Partially Accessible</option>
                    <option value="HasIssues" selected="@(ViewBag.Rating == "HasIssues")">Has Issues</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                <tr>
                    <th>Location</th>
                    <th>Title</th>
                    <th>Score</th>
                    <th>Rating</th>
                    <th>Reporter</th>
                    <th>Status</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold">@(r.Location?.Name ?? "—")</td>
                        <td>@r.Title @if (r.IsSampleData) { <span class="badge badge-secondary ms-1">Demo</span> }</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold">@r.AccessibilityScore%</span>
                                <div class="score-bar" style="width:60px"><div class="score-bar-fill bg-@(r.AccessibilityScore >= 75 ? "success" : r.AccessibilityScore >= 40 ? "warning" : "danger")" style="width:@r.AccessibilityScore%"></div></div>
                            </div>
                        </td>
                        <td><span class="badge @r.RatingBadgeClass">@r.RatingLabel</span></td>
                        <td class="text-muted-sm">@r.ReporterName</td>
                        <td><span class="badge badge-secondary">@r.Status</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><i class="bi bi-clipboard2"></i><p>No accessibility reports found.</p><a asp-action="Create" class="btn btn-primary mt-2">Submit First Report</a></div>
        }
    </div>
</div>
