@model IEnumerable<SmartLogisticsAccessibility.Web.Models.Location>
@{
    ViewData["Title"] = "Accessibility Map";
}

@section HeadStyles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-pin-map me-2 text-success"></i>Accessibility Map</h1>
        <div class="page-subtitle">Interactive map of location accessibility across the logistics network</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-clipboard2-check me-1"></i>All Reports</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-muted"></i>
                <span>Click a marker to see accessibility details.</span>
                <span class="ms-auto text-muted-sm">Map: © <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors</span>
            </div>
            <div class="card-body p-0">
                <div id="map"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Map Legend</div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2"><span style="width:14px;height:14px;background:#16a34a;border-radius:50%;display:inline-block"></span> Fully Accessible (≥75%)</div>
                <div class="d-flex align-items-center gap-2 mb-2"><span style="width:14px;height:14px;background:#d97706;border-radius:50%;display:inline-block"></span> Partially Accessible (40-74%)</div>
                <div class="d-flex align-items-center gap-2 mb-2"><span style="width:14px;height:14px;background:#dc2626;border-radius:50%;display:inline-block"></span> Has Issues (&lt;40%)</div>
                <div class="d-flex align-items-center gap-2"><span style="width:14px;height:14px;background:#6b7280;border-radius:50%;display:inline-block"></span> No Report Available</div>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="bi bi-geo-alt me-2"></i>Locations (@Model.Count())</div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" id="locationList">
                    @foreach (var loc in Model)
                    {
                        var bestReport = loc.AccessibilityReports.OrderByDescending(r => r.AccessibilityScore).FirstOrDefault();
                        var score = bestReport?.AccessibilityScore ?? -1;
                        var colorClass = score < 0 ? "secondary" : score >= 75 ? "success" : score >= 40 ? "warning" : "danger";
                        <a href="#" class="list-group-item list-group-item-action py-2 px-3 location-item"
                           data-lat="@loc.Latitude" data-lng="@loc.Longitude" data-name="@loc.Name">
                            <div class="d-flex align-items-center gap-2">
                                <span style="width:10px;height:10px;background:var(--@(colorClass == "secondary" ? "secondary" : colorClass));border-radius:50%;flex-shrink:0"></span>
                                <div>
                                    <div class="fw-bold small">@loc.Name</div>
                                    <div class="text-muted-sm">@loc.City @(score >= 0 ? $"— {score}%" : "— No reports")</div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
var map = L.map('map').setView([20.5937, 78.9629], 5);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19
}).addTo(map);

function colorForScore(score) {
    if (score < 0) return '#6b7280';
    if (score >= 75) return '#16a34a';
    if (score >= 40) return '#d97706';
    return '#dc2626';
}

function makeIcon(color) {
    return L.divIcon({
        className: '',
        html: `<div style="width:16px;height:16px;border-radius:50%;background:${color};border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.35)"></div>`,
        iconSize: [16,16], iconAnchor: [8,8], popupAnchor: [0,-10]
    });
}

var markers = [];
@foreach (var loc in Model)
{
    var bestReport = loc.AccessibilityReports.OrderByDescending(r => r.AccessibilityScore).FirstOrDefault();
    var score = bestReport?.AccessibilityScore ?? -1;
    var ratingLabel = bestReport?.RatingLabel ?? "No reports yet";
    var reportCount = loc.AccessibilityReports.Count;
    var detailsUrl = Url.Action("Details", "Locations", new { id = loc.Id });
    <text>
    (function(){
        var lat = @(loc.Latitude?.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) ?? "0");
        var lng = @(loc.Longitude?.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) ?? "0");
        var score = @score;
        var color = colorForScore(score);
        var marker = L.marker([lat, lng], { icon: makeIcon(color) }).addTo(map);
        marker.bindPopup(`<div style="min-width:200px">
            <strong>@Html.Raw(loc.Name.Replace("'", "\\'"))</strong><br>
            <span style="color:#64748b;font-size:0.85rem">@loc.City, @loc.State</span><br>
            <div style="margin-top:6px">
                <span style="display:inline-block;padding:.2rem .6rem;border-radius:4px;font-size:.8rem;font-weight:600;background:${color};color:#fff">
                    @(score >= 0 ? $"{score}% — {ratingLabel}" : "No reports yet")
                </span>
            </div>
            <div style="margin-top:8px;font-size:.8rem">@reportCount report(s)</div>
            <a href="@detailsUrl" style="margin-top:8px;display:inline-block;font-size:.8rem">View details →</a>
        </div>`);
        markers.push(marker);
    })();
    </text>
}

// Click list items to pan map
document.querySelectorAll('.location-item').forEach(el => {
    el.addEventListener('click', function(e) {
        e.preventDefault();
        var lat = parseFloat(this.dataset.lat);
        var lng = parseFloat(this.dataset.lng);
        if (lat && lng) { map.setView([lat, lng], 12); }
    });
});
</script>
}
