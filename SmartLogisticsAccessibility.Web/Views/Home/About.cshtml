@{
    ViewData["Title"] = "About Project";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-info-circle me-2 text-primary"></i>About This Project</h1>
        <div class="page-subtitle">CSE253 CA3 — SIH26002</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-lightbulb me-2 text-warning"></i>Project Overview</div>
            <div class="card-body">
                <h5 class="fw-bold">AI-Based Smart Logistics and Accessibility Intelligence Platform</h5>
                <p class="text-muted mb-3">Project Code: <strong>SIH26002</strong> | Course: <strong>CSE253 (.NET)</strong> | CA3 Allocated Project</p>
                <p>This platform addresses two interconnected real-world problems:</p>
                <ol>
                    <li class="mb-2"><strong>Smart Logistics Intelligence</strong> — Managing shipments, tracking delivery status, comparing route options, and providing transparent rule-based route recommendations to optimize delivery efficiency.</li>
                    <li class="mb-2"><strong>Accessibility Intelligence</strong> — Recording and analyzing location accessibility information (wheelchair access, ramps, elevators, etc.), calculating accessibility scores, and visualizing locations on an interactive map.</li>
                </ol>
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Transparency Note:</strong> The route recommendations in this platform are generated by a <em>rule-based scoring algorithm</em> written in C# — not a trained AI model. Each recommendation clearly displays how the score was calculated. Sample data is clearly labelled.
                </div>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-tools me-2 text-primary"></i>Technologies Used</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var tech in new[] {
                        ("bi-filetype-cs", "C# / .NET 10", "Primary backend language and runtime"),
                        ("bi-layout-text-window", "ASP.NET Core MVC", "Web framework — Controllers, Views, Models"),
                        ("bi-database", "EF Core 10.0.15 + SQL Server", "Object-relational mapping and database access"),
                        ("bi-bootstrap", "Bootstrap 5", "Responsive UI framework"),
                        ("bi-pin-map", "Leaflet + OpenStreetMap", "Interactive accessibility maps"),
                        ("bi-bar-chart", "Chart.js", "Dashboard data visualization"),
                        ("bi-gear", "Rule-Based Engine (C#)", "Transparent route scoring algorithm")
                    })
                    {
                        <div class="col-md-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi @tech.Item1 text-primary fs-5 mt-1"></i>
                                <div>
                                    <div class="fw-bold">@tech.Item2</div>
                                    <div class="text-muted-sm">@tech.Item3</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="bi bi-diagram-3 me-2 text-success"></i>Application Architecture</div>
            <div class="card-body">
                <p class="mb-2">This application follows the standard <strong>ASP.NET Core MVC pattern</strong>:</p>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                    <span class="badge badge-primary fs-6 p-2">Browser Request</span>
                    <i class="bi bi-arrow-right"></i>
                    <span class="badge badge-info fs-6 p-2">Controller (C#)</span>
                    <i class="bi bi-arrow-right"></i>
                    <span class="badge badge-secondary fs-6 p-2">DbContext (EF Core)</span>
                    <i class="bi bi-arrow-right"></i>
                    <span class="badge badge-warning fs-6 p-2">SQL Server</span>
                    <i class="bi bi-arrow-right"></i>
                    <span class="badge badge-success fs-6 p-2">View (Razor)</span>
                </div>
                <ul class="mt-3 mb-0">
                    <li><strong>Models/</strong> — C# classes representing database tables (Location, Shipment, Route, AccessibilityReport)</li>
                    <li><strong>Controllers/</strong> — Handle HTTP requests, query the database, pass data to Views</li>
                    <li><strong>Views/</strong> — Razor templates (.cshtml) that render HTML from model data</li>
                    <li><strong>Data/ApplicationDbContext.cs</strong> — EF Core bridge between C# objects and SQL Server tables</li>
                    <li><strong>Services/RouteRecommendationService.cs</strong> — Rule-based scoring engine for route comparison</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-people me-2 text-primary"></i>Team Members</div>
            <div class="card-body">
                @foreach (var member in new[] {
                    ("RK3P25RAA28", "Peta Venkata Ashok"),
                    ("RK3P25RAA29", "Rehan Khan"),
                    ("RK3P25RAA30", "Ishaan Sehdev")
                })
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="stat-icon stat-icon-blue" style="width:42px;height:42px;font-size:1.1rem;border-radius:10px">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <div class="fw-bold">@member.Item2</div>
                            <div class="text-muted-sm">@member.Item1</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-graph-up me-2 text-success"></i>Sector Applications</div>
            <div class="card-body">
                <ul class="mb-0">
                    <li class="mb-2"><strong>E-Commerce</strong> — Track and optimize last-mile delivery</li>
                    <li class="mb-2"><strong>Healthcare</strong> — Prioritize critical medical supply shipments</li>
                    <li class="mb-2"><strong>Government</strong> — Audit public building accessibility compliance</li>
                    <li class="mb-2"><strong>Tourism</strong> — Map accessible tourist attractions and routes</li>
                    <li class="mb-2"><strong>Manufacturing</strong> — Manage raw material and component logistics</li>
                    <li><strong>Urban Planning</strong> — Use accessibility data to plan infrastructure improvements</li>
                </ul>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="bi bi-code-slash me-2"></i>Key Files for Viva</div>
            <div class="card-body">
                <ul class="mb-0 text-muted-sm">
                    <li><code>Program.cs</code> — Startup and DI container</li>
                    <li><code>Data/ApplicationDbContext.cs</code> — EF Core tables</li>
                    <li><code>Models/Shipment.cs</code> — Shipment entity</li>
                    <li><code>Models/AccessibilityReport.cs</code> — Score calculation</li>
                    <li><code>Services/RouteRecommendationService.cs</code> — Recommendation algorithm</li>
                    <li><code>Controllers/ShipmentsController.cs</code> — CRUD example</li>
                    <li><code>appsettings.json</code> — Connection string</li>
                </ul>
            </div>
        </div>
    </div>
</div>
