@model SmartLogisticsAccessibility.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stat Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-blue"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="stat-value">@Model.TotalShipments</div>
                <div class="stat-label">Total Shipments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-cyan"><i class="bi bi-truck"></i></div>
            <div>
                <div class="stat-value">@Model.InTransitShipments</div>
                <div class="stat-label">In Transit</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-green"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-value">@Model.DeliveredShipments</div>
                <div class="stat-label">Delivered</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-red"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-value">@Model.DelayedShipments</div>
                <div class="stat-label">Delayed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-green"><i class="bi bi-universal-access"></i></div>
            <div>
                <div class="stat-value">@Model.FullyAccessibleCount</div>
                <div class="stat-label">Fully Accessible</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-purple"><i class="bi bi-geo-alt"></i></div>
            <div>
                <div class="stat-value">@Model.TotalLocations</div>
                <div class="stat-label">Locations</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Shipment Status Chart -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-pie-chart text-primary"></i> Shipment Status Breakdown
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="shipmentChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <!-- Accessibility Chart -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart text-success"></i> Accessibility Rating Overview
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="accessibilityChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Shipments -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box-seam me-1 text-primary"></i> Recent Shipments</span>
                <a asp-controller="Shipments" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentShipments.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th>Tracking #</th>
                            <th>Route</th>
                            <th>Status</th>
                            <th>Priority</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.RecentShipments)
                        {
                            <tr>
                                <td><a asp-controller="Shipments" asp-action="Details" asp-route-id="@s.Id" class="fw-bold">@s.TrackingNumber</a></td>
                                <td class="text-muted-sm">@(s.OriginLocation?.City ?? "—") → @(s.DestinationLocation?.City ?? "—")</td>
                                <td><span class="badge @s.StatusBadgeClass">@s.Status</span></td>
                                <td><span class="badge @s.PriorityBadgeClass">@s.Priority</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-box"></i><p>No shipments yet.</p></div>
                }
            </div>
        </div>
    </div>
    <!-- Recent Accessibility Reports -->
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clipboard2-check me-1 text-success"></i> Recent Reports</span>
                <a asp-controller="AccessibilityReports" asp-action="Index" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentReports.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Location</th><th>Score</th><th>Rating</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.RecentReports)
                        {
                            <tr>
                                <td><a asp-controller="AccessibilityReports" asp-action="Details" asp-route-id="@r.Id" class="fw-bold">@(r.Location?.Name ?? "—")</a></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold">@r.AccessibilityScore%</span>
                                        <div class="score-bar flex-grow-1" style="width:70px">
                                            <div class="score-bar-fill bg-@(r.AccessibilityScore >= 75 ? "success" : r.AccessibilityScore >= 40 ? "warning" : "danger")"
                                                 style="width:@r.AccessibilityScore%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge @r.RatingBadgeClass">@r.RatingLabel</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-clipboard2"></i><p>No reports yet.</p></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
// Shipment Status Doughnut Chart
new Chart(document.getElementById('shipmentChart'), {
    type: 'doughnut',
    data: {
        labels: @Html.Raw(Model.ShipmentStatusLabelsJson),
        datasets: [{ data: @Html.Raw(Model.ShipmentStatusDataJson),
            backgroundColor: ['#fef3c7','#cffafe','#dcfce7','#fee2e2','#f1f5f9'],
            borderColor: ['#d97706','#0891b2','#16a34a','#dc2626','#6b7280'],
            borderWidth: 2
        }]
    },
    options: { responsive: true, cutout: '65%',
        plugins: { legend: { position: 'bottom', labels: { font: { size: 12 }, padding: 16 } } }
    }
});
// Accessibility Bar Chart
new Chart(document.getElementById('accessibilityChart'), {
    type: 'bar',
    data: {
        labels: @Html.Raw(Model.AccessibilityRatingLabelsJson),
        datasets: [{
            label: 'Locations',
            data: @Html.Raw(Model.AccessibilityRatingDataJson),
            backgroundColor: ['#dcfce7','#fef3c7','#fee2e2'],
            borderColor: ['#16a34a','#d97706','#dc2626'],
            borderWidth: 2, borderRadius: 8
        }]
    },
    options: { responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
    }
});
</script>
}
