@model SmartLogisticsAccessibility.Web.Models.Location
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Location" : "New Location";
}
<div class="page-header">
    <h1><i class="bi bi-geo-alt me-2 text-primary"></i>@(isEdit ? "Edit Location" : "New Location")</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="card" style="max-width:720px">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                <div class="col-md-4">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" asp-items="ViewBag.Types" class="form-select"></select>
                </div>
                <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger small"></span></div>
                <div class="col-md-5"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="State" class="form-label"></label><input asp-for="State" class="form-control" /><span asp-validation-for="State" class="text-danger small"></span></div>
                <div class="col-md-3"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" type="number" step="0.0001" /></div>
                <div class="col-md-6"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" type="number" step="0.0001" /></div>
                <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@(isEdit ? "Save Changes" : "Add Location")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
