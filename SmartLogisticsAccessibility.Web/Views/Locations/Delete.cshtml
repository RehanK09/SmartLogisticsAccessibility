@model SmartLogisticsAccessibility.Web.Models.Location
@{ ViewData["Title"] = "Delete Location"; }
<div class="page-header"><h1 class="text-danger"><i class="bi bi-trash me-2"></i>Delete Location</h1></div>
<div class="card" style="max-width:520px">
    <div class="card-body">
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Deleting this location will also delete all associated accessibility reports. This cannot be undone.</div>
        <dl class="row mb-3">
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8 fw-bold">@Model.Name</dd>
            <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@Model.FullAddress</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Confirm Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
