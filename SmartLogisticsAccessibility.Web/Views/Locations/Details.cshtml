@model SmartLogisticsAccessibility.Web.Models.Location
@{
    ViewData["Title"] = "Location Details — " + Model.Name;
}
<div class="page-header">
    <div>
        <h1><i class="bi bi-geo-alt me-2 text-primary"></i>@Model.Name</h1>
        <div class="page-subtitle">@Model.FullAddress</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header">Location Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Type</dt><dd class="col-sm-8"><span class="badge badge-secondary">@Model.Type</span></dd>
                    <dt class="col-sm-4">City/State</dt><dd class="col-sm-8">@Model.City, @Model.State @Model.PostalCode</dd>
                    @if (Model.HasCoordinates)
                    {
                        <dt class="col-sm-4">Coordinates</dt><dd class="col-sm-8">@Model.Latitude?.ToString("F4"), @Model.Longitude?.ToString("F4")</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@Model.Notes</dd>
                    }
                </dl>
            </div>
        </div>
        @if (Model.AccessibilityReports.Any())
        {
            <div class="card">
                <div class="card-header">Accessibility Reports (@Model.AccessibilityReports.Count)</div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead><tr><th>Title</th><th>Score</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.AccessibilityReports)
                        {
                            <tr>
                                <td>@r.Title</td>
                                <td>@r.AccessibilityScore%</td>
                                <td><a asp-controller="AccessibilityReports" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header">Shipment Activity</div>
            <div class="card-body">
                <div class="d-flex justify-content-around">
                    <div class="text-center"><div class="stat-value">@Model.OriginShipments.Count</div><div class="text-muted-sm">Outbound</div></div>
                    <div class="text-center"><div class="stat-value">@Model.DestinationShipments.Count</div><div class="text-muted-sm">Inbound</div></div>
                </div>
            </div>
        </div>
        @if (Model.HasCoordinates)
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-pin-map me-2"></i>Map Preview</div>
                <div class="card-body p-0">
                    <div id="locMap" style="height:200px;border-radius:0 0 var(--radius) var(--radius)"></div>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.HasCoordinates)
{
    @section HeadStyles {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
    @section Scripts {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
        var map = L.map('locMap').setView([@Model.Latitude, @Model.Longitude], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(map);
        L.marker([@Model.Latitude, @Model.Longitude]).addTo(map).bindPopup('@Html.Raw(Model.Name.Replace("'", "\\'"))').openPopup();
        </script>
    }
}
