@model IEnumerable<SmartLogisticsAccessibility.Web.Models.Location>
@{
    ViewData["Title"] = "Locations";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-geo-alt me-2 text-primary"></i>Locations</h1>
        <div class="page-subtitle">Warehouses, hubs, delivery points and more</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Location</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="max-width:320px" placeholder="Search locations…" />
    <button class="btn btn-primary"><i class="bi bi-search"></i></button>
    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
</form>

<div class="row g-3">
    @foreach (var loc in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div>
                            <div class="fw-bold">@loc.Name</div>
                            <div class="text-muted-sm">@loc.FullAddress</div>
                        </div>
                        <span class="badge badge-secondary">@loc.Type</span>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        @if (loc.HasCoordinates) { <span class="badge badge-info"><i class="bi bi-pin-map me-1"></i>Mapped</span> }
                        <span class="badge @(loc.IsActive ? "badge-success" : "badge-secondary")">@(loc.IsActive ? "Active" : "Inactive")</span>
                        @if (loc.IsSampleData) { <span class="badge badge-secondary">Demo</span> }
                        @if (loc.AccessibilityReports.Any()) { <span class="badge badge-primary">@loc.AccessibilityReports.Count Report(s)</span> }
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@loc.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>Details</a>
                        <a asp-action="Edit" asp-route-id="@loc.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a asp-action="Delete" asp-route-id="@loc.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card"><div class="empty-state"><i class="bi bi-geo-alt"></i><p>No locations found.</p><a asp-action="Create" class="btn btn-primary mt-2">Add First Location</a></div></div>
        </div>
    }
</div>
