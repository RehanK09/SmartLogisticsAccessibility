@model SmartLogisticsAccessibility.Web.Models.Route
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Route" : "New Route";
}
<div class="page-header">
    <h1><i class="bi bi-map me-2 text-primary"></i>@(isEdit ? "Edit Route" : "New Route")</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="card" style="max-width:720px">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="OriginLocationId" class="form-label">Origin</label><select asp-for="OriginLocationId" asp-items="ViewBag.Locations" class="form-select"><option value="">Select…</option></select></div>
                <div class="col-md-6"><label asp-for="DestinationLocationId" class="form-label">Destination</label><select asp-for="DestinationLocationId" asp-items="ViewBag.Locations" class="form-select"><option value="">Select…</option></select></div>
                <div class="col-md-4"><label asp-for="EstimatedDistanceKm" class="form-label"></label><input asp-for="EstimatedDistanceKm" class="form-control" type="number" step="0.1" /></div>
                <div class="col-md-4"><label asp-for="EstimatedTravelTimeHours" class="form-label"></label><input asp-for="EstimatedTravelTimeHours" class="form-control" type="number" step="0.1" /></div>
                <div class="col-md-4"><label asp-for="EstimatedCostINR" class="form-label"></label><input asp-for="EstimatedCostINR" class="form-control" type="number" /></div>
                <div class="col-md-6"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<SmartLogisticsAccessibility.Web.Models.RouteType>()" class="form-select"></select></div>
                <div class="col-md-6"><label asp-for="AccessibilityLevel" class="form-label"></label><select asp-for="AccessibilityLevel" asp-items="Html.GetEnumSelectList<SmartLogisticsAccessibility.Web.Models.AccessibilityLevel>()" class="form-select"></select></div>
                <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@(isEdit ? "Save Changes" : "Add Route")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
