@model SmartLogisticsAccessibility.Web.Models.Route
@{ ViewData["Title"] = "Delete Route"; }
<div class="page-header"><h1 class="text-danger"><i class="bi bi-trash me-2"></i>Delete Route</h1></div>
<div class="card" style="max-width:520px">
    <div class="card-body">
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>This cannot be undone. Shipments using this route will have their route assignment cleared.</div>
        <dl class="row mb-3">
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8 fw-bold">@Model.Name</dd>
            <dt class="col-sm-4">Origin</dt><dd class="col-sm-8">@(Model.OriginLocation?.Name ?? "—")</dd>
            <dt class="col-sm-4">Destination</dt><dd class="col-sm-8">@(Model.DestinationLocation?.Name ?? "—")</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Confirm Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
