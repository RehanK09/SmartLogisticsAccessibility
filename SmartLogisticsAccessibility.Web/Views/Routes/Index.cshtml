@model IEnumerable<SmartLogisticsAccessibility.Web.Models.Route>
@{ ViewData["Title"] = "Manage Routes"; }
<div class="page-header">
    <div>
        <h1><i class="bi bi-map me-2 text-primary"></i>Manage Routes</h1>
        <div class="page-subtitle">All configured routes in the logistics network</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Intelligence" class="btn btn-outline-primary"><i class="bi bi-signpost-split me-1"></i>Route Intelligence</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Route</a>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead><tr><th>Route Name</th><th>Origin</th><th>Destination</th><th>Type</th><th>Distance</th><th>Time</th><th>Cost</th><th>Accessibility</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold">@r.Name @if (r.IsSampleData) { <span class="badge badge-secondary ms-1">Demo</span> }</td>
                        <td class="text-muted-sm">@(r.OriginLocation?.City ?? "—")</td>
                        <td class="text-muted-sm">@(r.DestinationLocation?.City ?? "—")</td>
                        <td><span class="badge badge-secondary">@r.Type</span></td>
                        <td class="text-muted-sm">@r.EstimatedDistanceKm km</td>
                        <td class="text-muted-sm">@r.EstimatedTravelTimeHours hrs</td>
                        <td class="text-muted-sm">₹@(r.EstimatedCostINR?.ToString("N0") ?? "—")</td>
                        <td><span class="badge @r.AccessibilityLevelBadgeClass">@r.AccessibilityLevel</span></td>
                        <td><div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else { <div class="empty-state"><i class="bi bi-map"></i><p>No routes yet.</p><a asp-action="Create" class="btn btn-primary mt-2">Add First Route</a></div> }
    </div>
</div>
