<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SmartLogistics</title>
    <script type="importmap"></script>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartLogisticsAccessibility.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("HeadStyles", required: false)
</head>
<body>

<!-- ============================================================ SIDEBAR === -->
<nav id="sidebar">
    <div class="sidebar-brand">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-truck fs-5 text-white"></i>
            <span class="brand-title">SmartLogistics</span>
        </div>
        <span class="brand-subtitle">AI-Based Logistics &amp; Accessibility Platform</span>
    </div>

    <div class="nav-section-header">Main</div>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() != "About" ? "active" : "")"
       asp-controller="Home" asp-action="Index">
        <i class="bi bi-grid-1x2"></i> Dashboard
    </a>

    <div class="nav-section-header">Logistics</div>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shipments" ? "active" : "")"
       asp-controller="Shipments" asp-action="Index">
        <i class="bi bi-box-seam"></i> Shipments
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Routes" && ViewContext.RouteData.Values["action"]?.ToString() == "Intelligence" ? "active" : "")"
       asp-controller="Routes" asp-action="Intelligence">
        <i class="bi bi-signpost-split"></i> Route Intelligence
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Routes" && ViewContext.RouteData.Values["action"]?.ToString() != "Intelligence" ? "active" : "")"
       asp-controller="Routes" asp-action="Index">
        <i class="bi bi-map"></i> Manage Routes
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Locations" ? "active" : "")"
       asp-controller="Locations" asp-action="Index">
        <i class="bi bi-geo-alt"></i> Locations
    </a>

    <div class="nav-section-header">Accessibility</div>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AccessibilityReports" && ViewContext.RouteData.Values["action"]?.ToString() == "Map" ? "active" : "")"
       asp-controller="AccessibilityReports" asp-action="Map">
        <i class="bi bi-pin-map"></i> Accessibility Map
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AccessibilityReports" && ViewContext.RouteData.Values["action"]?.ToString() != "Map" ? "active" : "")"
       asp-controller="AccessibilityReports" asp-action="Index">
        <i class="bi bi-clipboard2-check"></i> Accessibility Reports
    </a>

    <div class="nav-section-header">Info</div>
    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")"
       asp-controller="Home" asp-action="About">
        <i class="bi bi-info-circle"></i> About Project
    </a>

    <div class="sidebar-footer">
        <div>CSE253 · CA3 · SIH26002</div>
        <div class="mt-1">
            Peta Ashok · Rehan Khan · Ishaan Sehdev
        </div>
    </div>
</nav>

<!-- ============================================================ TOPBAR ==== -->
<div id="topbar">
    <button id="sidebar-toggle" class="btn btn-sm btn-outline-secondary me-2" onclick="document.getElementById('sidebar').classList.toggle('show')">
        <i class="bi bi-list"></i>
    </button>
    <div>
        <div class="topbar-title">@(ViewData["Title"] ?? "Dashboard")</div>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2">
        <span class="topbar-badge"><i class="bi bi-database-check me-1"></i>SQL Server 2025</span>
        <span class="topbar-badge"><i class="bi bi-code-slash me-1"></i>.NET 10</span>
    </div>
</div>

<!-- ============================================================ CONTENT === -->
<div id="main-content">

    @* Success / Error messages *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</div>

<!-- ============================================================ SCRIPTS === -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
