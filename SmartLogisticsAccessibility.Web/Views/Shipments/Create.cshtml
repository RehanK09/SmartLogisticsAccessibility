@model SmartLogisticsAccessibility.Web.Models.Shipment
@{
    ViewData["Title"] = "New Shipment";
    var isEdit = Model.Id != 0;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-box-seam me-2 text-primary"></i>@(isEdit ? "Edit Shipment" : "New Shipment")</h1>
        <div class="page-subtitle">@(isEdit ? $"Editing {Model.TrackingNumber}" : "Create a new shipment record")</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            <input type="hidden" asp-for="Id" />
            @if (isEdit) { <input type="hidden" asp-for="CreatedAt" /> }

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="TrackingNumber" class="form-label"></label>
                    <input asp-for="TrackingNumber" class="form-control" />
                    <span asp-validation-for="TrackingNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SenderName" class="form-label"></label>
                    <input asp-for="SenderName" class="form-control" />
                    <span asp-validation-for="SenderName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReceiverName" class="form-label"></label>
                    <input asp-for="ReceiverName" class="form-control" />
                    <span asp-validation-for="ReceiverName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OriginLocationId" class="form-label">Origin Location</label>
                    <select asp-for="OriginLocationId" asp-items="ViewBag.Locations" class="form-select">
                        <option value="">Select origin…</option>
                    </select>
                    <span asp-validation-for="OriginLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DestinationLocationId" class="form-label">Destination Location</label>
                    <select asp-for="DestinationLocationId" asp-items="ViewBag.DestinationLocations" class="form-select">
                        <option value="">Select destination…</option>
                    </select>
                    <span asp-validation-for="DestinationLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<SmartLogisticsAccessibility.Web.Models.ShipmentStatus>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<SmartLogisticsAccessibility.Web.Models.ShipmentPriority>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="WeightKg" class="form-label"></label>
                    <input asp-for="WeightKg" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="WeightKg" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EstimatedDeliveryDate" class="form-label"></label>
                    <input asp-for="EstimatedDeliveryDate" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ActualDeliveryDate" class="form-label"></label>
                    <input asp-for="ActualDeliveryDate" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="AssignedRouteId" class="form-label">Assigned Route (optional)</label>
                    <select asp-for="AssignedRouteId" asp-items="ViewBag.Routes" class="form-select">
                        <option value="">None</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@(isEdit ? "Save Changes" : "Create Shipment")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
