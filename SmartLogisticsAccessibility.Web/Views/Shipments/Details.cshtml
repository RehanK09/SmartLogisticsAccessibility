@model SmartLogisticsAccessibility.Web.Models.Shipment
@{
    ViewData["Title"] = "Shipment Details — " + Model.TrackingNumber;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-box-seam me-2 text-primary"></i>@Model.TrackingNumber</h1>
        <div class="page-subtitle">@Model.Description</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (Model.IsSampleData)
{
    <div class="alert alert-warning mb-3"><i class="bi bi-info-circle me-2"></i>This is <strong>sample / demo data</strong> created for demonstration purposes.</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">Shipment Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><div class="text-muted-sm">Sender</div><div class="fw-bold">@Model.SenderName</div></div>
                    <div class="col-md-6"><div class="text-muted-sm">Receiver</div><div class="fw-bold">@Model.ReceiverName</div></div>
                    <div class="col-md-6"><div class="text-muted-sm">Origin</div><div class="fw-bold">@(Model.OriginLocation?.Name ?? "—") <span class="text-muted-sm">(@(Model.OriginLocation?.City ?? ""))</span></div></div>
                    <div class="col-md-6"><div class="text-muted-sm">Destination</div><div class="fw-bold">@(Model.DestinationLocation?.Name ?? "—") <span class="text-muted-sm">(@(Model.DestinationLocation?.City ?? ""))</span></div></div>
                    <div class="col-md-4"><div class="text-muted-sm">Weight</div><div class="fw-bold">@(Model.WeightKg.HasValue ? $"{Model.WeightKg:F1} kg" : "—")</div></div>
                    <div class="col-md-4"><div class="text-muted-sm">Est. Delivery</div><div class="fw-bold">@(Model.EstimatedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                    <div class="col-md-4"><div class="text-muted-sm">Actual Delivery</div><div class="fw-bold">@(Model.ActualDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="col-12"><div class="text-muted-sm">Notes</div><div>@Model.Notes</div></div>
                    }
                </div>
            </div>
        </div>
        @if (Model.AssignedRoute != null)
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-signpost-split me-2"></i>Assigned Route</div>
                <div class="card-body">
                    <div class="fw-bold mb-2">@Model.AssignedRoute.Name</div>
                    <div class="row g-2 text-muted-sm">
                        <div class="col-auto"><i class="bi bi-rulers me-1"></i>@Model.AssignedRoute.EstimatedDistanceKm km (est.)</div>
                        <div class="col-auto"><i class="bi bi-clock me-1"></i>@Model.AssignedRoute.EstimatedTravelTimeHours hrs (est.)</div>
                        <div class="col-auto"><i class="bi bi-currency-rupee me-1"></i>@(Model.AssignedRoute.EstimatedCostINR?.ToString("N0") ?? "—") (est.)</div>
                        <div class="col-auto"><span class="badge @Model.AssignedRoute.AccessibilityLevelBadgeClass">@Model.AssignedRoute.AccessibilityLevel Accessibility</span></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">Status &amp; Priority</div>
            <div class="card-body text-center">
                <span class="badge @Model.StatusBadgeClass" style="font-size:1.1rem;padding:.5rem 1.2rem">@Model.Status</span>
                <div class="mt-3">
                    <span class="badge @Model.PriorityBadgeClass" style="font-size:.95rem;padding:.4rem 1rem">@Model.Priority Priority</span>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">Timestamps</div>
            <div class="card-body">
                <div class="text-muted-sm">Created</div>
                <div class="mb-2">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                <div class="text-muted-sm">Last Updated</div>
                <div>@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
            </div>
        </div>
    </div>
</div>
